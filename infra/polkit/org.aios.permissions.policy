<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <action id="org.aios.permissions">
    <description>AIOS elevated permission</description>
    <message>Authentication is required for AIOS privileged actions.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
